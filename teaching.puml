@startuml teaching
title Teaching a CyberNetwork

start
:Receive the external sample, one expected band per output,\nthe learn strategy, and a positive learning divider;

if (The sample width, the band count, the divider, or a locked neuron is illegal?) then (yes)
  :Reject the call before mutating any neuron;
  stop
else (no)
endif

partition "1. Forward snapshot" {
  :Walk the neurons in deterministic topological order;
  :Each slot reads an external symbol\nor the confidence ordinal 0..3 of an earlier neuron;
  :Sum the cells those symbols address;
  :Record the inputs, the sum, and the confidence band.\nThe wire signal is that band's ordinal;
  note right
    Later steps read this snapshot.
    A cell changed for this sample
    does not affect the rest of the same walk.
  end note
}

partition "2. Credit assignment, from the outputs backward" {
  while (More neurons, from the outputs toward the inputs?) is (yes)
    if (This neuron is an output?) then (yes)
      :Target band is the requested band;
      if (Its band is already the requested one?) then (yes)
        :Leave it with zero pressure and zero edit;
      else (no)
        :Pressure and edit are the signed distance\nfrom the sum to the edge of the requested band;
      endif
    else (hidden)
      if (Every consumer of this neuron has zero pressure?) then (yes)
        :Keep current band as target; leave edit at zero;
      else (no)
        :Compute slot-weighted downstream share across unsatisfied consumers;
        :Score each candidate confidence 0..3 across all consumers\n(error reduction on unsatisfied consumers minus damage to satisfied ones,\nrejecting opposing transitions onto non-inhibitory cells);
        if (A candidate symbol yields net consumer improvement?) then (yes)
          :Target band is that confidence;
          :Edit is the signed gap to that band,\ncapped by the neuron's error-share magnitude;
          :Propagate pressure upstream\n(toward band center for bounded interior bands);
        else (no)
          if (Share != 0 and stepping does not break\nsatisfied consumers more than remaining error?) then (yes)
            :Pressure and edit equal that share;
          else (no)
            :Keep current band as target; leave edit at zero;
          endif
        endif
      endif
    endif
  endwhile (no)
}

partition "3. Rewrite the cells that fired" {
  while (More neurons in forward order?) is (yes)
    if (This neuron has zero edit?) then (yes)
      :Skip it;
    else (no)
      :Divider is learningDivider * (depth + 1) / layerWeight,\nand at least 1;
      note right
        Depth is the shortest hop count to an output.
        Outputs stay at weight 1.
        A heavier hidden layer spends more of the same share.
      end note
      if (Output neuron with target band?) then (yes)
        :Teach output toward target band with divider;
      else (hidden edit)
        :Nudge hidden neuron by edit scaled by divider\n(at least one step of edit's sign);
      endif
      if (Strategy is SEQUENTIAL?) then (yes)
        :Walk unsaturated addressed rows in order and wrap;
      else (RANDOM)
        :Pick a random unsaturated addressed row for each step;
      endif
      :Add or subtract 1 in that cell,\nstopping when all addressed cells reach -128 or 127.\nCells this sample did not address stay as they are;
    endif
  endwhile (no)
}

stop

@enduml
